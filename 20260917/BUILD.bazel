load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python/uv:lock.bzl", "lock")
load("@pypi//:requirements.bzl", "requirement")

lock(
    name = "pypi",
    srcs = ["pypi.txt"],
    out = "pypi.lock",
)

py_binary(
    name = "index",
    srcs = ["index.py"],
    data = [
        ".env",
    ],
    main = "index.py",
    deps = [
        requirement("chonkie"),
        requirement("google-genai"),
        requirement("polars"),
        requirement("numpy"),
        requirement("puremagic"),
        requirement("python-dotenv"),
        requirement("requests"),
    ],
)

py_binary(
    name = "cluster",
    srcs = ["cluster.py"],
    data = [
        ".env",
    ],
    main = "cluster.py",
    deps = [
        requirement("numpy"),
        requirement("polars"),
        requirement("python-dotenv"),
    ],
)

